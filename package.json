{
  "name": "farmland",
  "version": "1.0.0",
  "description": "A modern, responsive e-commerce application for organic produce built with React 19 and modern web technologies.",
  "private": true,
  "type": "module",
  "keywords": [
    "react",
    "ecommerce",
    "organic",
    "produce",
    "shopping-cart",
    "vite",
    "responsive",
    "modern-web"
  ],
  "author": {
    "name": "Ayoroq",
    "url": "https://github.com/ayoroq"
  },
  "license": "MIT",
  "homepage": "https://farmland-produce.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayoroq/farmland.git"
  },
  "bugs": {
    "url": "https://github.com/ayoroq/farmland/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
